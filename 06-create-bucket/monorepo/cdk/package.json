{
  "name": "@root/cdk",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "deploy": "cdk deploy lesson-bucket --require-approval never --app 'tsx ./src/bin/bucket.ts'",
    "destroy": "cdk destroy lesson-bucket --force --require-approval never --app 'tsx ./src/bin/bucket.ts'",
    "type-check": "tsc --noEmit",
    "package-cleanup": "rm -rf node_modules dist cdk.out"
  },
  "dependencies": {
    "aws-cdk-lib": "2.235.1",
    "constructs": "10.4.5"
  },
  "devDependencies": {
    "@types/node": "25.0.3",
    "aws-cdk": "2.1101.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
