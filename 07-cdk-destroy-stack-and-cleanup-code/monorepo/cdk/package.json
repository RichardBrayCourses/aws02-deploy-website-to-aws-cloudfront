{
  "name": "@root/cdk",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "cdk:deploy": "cdk deploy cloudfront-website --require-approval never --app 'tsx ./src/bin/cloudfront.ts'",
    "cdk:destroy": "cdk destroy cloudfront-website --force --require-approval never --app 'tsx ./src/bin/cloudfront.ts'",
    "package-cleanup": "rm -rf node_modules cdk.out"
  },
  "dependencies": {
    "aws-cdk-lib": "2.235.1",
    "constructs": "10.4.5"
  },
  "devDependencies": {
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
